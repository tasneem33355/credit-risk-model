# Copy this file to .env and fill in real values. .env is git-ignored.

# Directory holding the trained model artifacts produced by model/train.py
MODEL_DIR=model/artifacts

# Optional API key required in the X-API-Key header for /score (leave blank to disable)
API_KEY=AQ.Ab8RN6ItjkHWUJnulnEeTWhXcf6fAMPJnw8oJPRlVk2tdpqcPA

LOG_LEVEL=INFO

# ----------------------------------------------------------------------
# AI Explainability Layer (llm_explainer.py) -- powers the "AI Assistant"
# dashboard tab and the POST /explain endpoint in api.py.
# Free provider: Google Gemini. Get a free key (no credit card) at
# https://aistudio.google.com/apikey -- see docs/llm_layer.md for details.
# ----------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
